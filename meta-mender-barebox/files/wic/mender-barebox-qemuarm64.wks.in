# Mender + barebox A/B disk layout for qemuarm64 (wrynose).
#
# Boot chain at runtime:
#   qemu-system-aarch64 -M virt -kernel barebox-dt-2nd.img -> barebox reads the
#   U-Boot env (ubootvar) on mender-bootenv, runs /env/boot/mender, mounts the
#   selected rootfs slot and boots its /boot/Image.
#
# GPT layout on the virtio disk (/dev/vda). Rootfs stays at partitions 2/3 so
# Mender's mender_boot_part=2/3 convention holds; the raw U-Boot env partition
# is last:
#   1. mender-boot     64 MB FAT  carries a copy of the barebox image (handy for
#                                  a -drive boot path; the demo loads barebox via
#                                  -kernel, so this is otherwise unused).
#   2. mender-rootfsa 1024 MB     rootfs slot A (kernel in its /boot)
#   3. mender-rootfsb 1024 MB     rootfs slot B (built-time clone of A)
#   4. mender-data     128 MB     persistent /data, bind-mounted over
#                                  /var/lib/mender so the Mender state survives
#                                  the rootfs swap of an OTA.
#   5. mender-bootenv    1 MB     raw, non-redundant U-Boot env (mkenvimage
#                                  output, first 0x4000 used) read by both
#                                  barebox' ubootvar and libubootenv.
#
# Single-line `part` entries: wic's ksparser uses shlex which can choke on
# backslash line continuations under recent Python.

bootloader --ptable gpt --timeout=2
part /boot/firmware --source bootimg-partition --ondisk vda --fstype=vfat --label boot --part-name=mender-boot --align 1024 --fixed-size 64M --active --no-fstab-update
part / --source rootfs --ondisk vda --fstype=ext4 --label rootfsa --part-name=mender-rootfsa --align 1024 --fixed-size 1024M --use-uuid --exclude-path data/
part --source rootfs --ondisk vda --fstype=ext4 --label rootfsb --part-name=mender-rootfsb --align 1024 --fixed-size 1024M --use-uuid --exclude-path data/
part /data --source rootfs --change-directory=data --ondisk vda --fstype=ext4 --label data --part-name=mender-data --align 1024 --fixed-size 128M --use-uuid --no-fstab-update
part --source rawcopy --sourceparams="file=mender-uboot-env.img" --ondisk vda --uuid=e6f1c2d3-4a5b-4c6d-8e7f-0a1b2c3d4e5f --part-name=mender-bootenv --align 1024 --fixed-size 1M --no-fstab-update
