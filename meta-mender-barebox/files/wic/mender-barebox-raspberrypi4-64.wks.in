# Mender + barebox A/B disk layout for raspberrypi4-64 (wrynose).
#
# Boot chain at runtime:
#   RPi GPU firmware -> config.txt (kernel=barebox.img) -> barebox reads the
#   U-Boot env (ubootvar) on mender-bootenv, runs /env/boot/mender, mounts the
#   selected rootfs slot and boots its /boot/Image + DTB.
#
# The first partition is the RPi boot/firmware FAT: it must carry the GPU
# firmware (bootcode/start4.elf/fixup4.dat), config.txt with kernel=barebox.img
# + enable_uart=1, and the barebox image (named barebox.img). These are staged
# by the bootimg-partition plugin from IMAGE_BOOT_FILES, set in the kas wrapper
# (meta-raspberrypi's firmware + the barebox image + config.txt).
#
# Rootfs stays at partitions 2/3 (Mender's mender_boot_part=2/3 convention);
# the raw U-Boot env partition is last:
#   1. mender-boot     64 MB FAT  RPi firmware + config.txt + barebox.img
#   2. mender-rootfsa 1024 MB     rootfs slot A (kernel + DTB in its /boot)
#   3. mender-rootfsb 1024 MB     rootfs slot B (build-time clone of A)
#   4. mender-data     128 MB     persistent /data (bind-mounted over
#                                  /var/lib/mender)
#   5. mender-bootenv    1 MB     raw, non-redundant U-Boot env, read by both
#                                  barebox' ubootvar and libubootenv
#
# Single-line `part` entries: wic's ksparser uses shlex which can choke on
# backslash line continuations under recent Python.

bootloader --ptable gpt --timeout=2
part /boot/firmware --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label boot --part-name=mender-boot --align 4096 --fixed-size 64M --active --no-fstab-update
part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfsa --part-name=mender-rootfsa --align 4096 --fixed-size 1024M --use-uuid --exclude-path data/
part --source rootfs --ondisk mmcblk0 --fstype=ext4 --label rootfsb --part-name=mender-rootfsb --align 4096 --fixed-size 1024M --use-uuid --exclude-path data/
part /data --source rootfs --change-directory=data --ondisk mmcblk0 --fstype=ext4 --label data --part-name=mender-data --align 4096 --fixed-size 128M --use-uuid --no-fstab-update
part --source rawcopy --sourceparams="file=mender-uboot-env.img" --ondisk mmcblk0 --uuid=e6f1c2d3-4a5b-4c6d-8e7f-0a1b2c3d4e5f --part-name=mender-bootenv --align 4096 --fixed-size 1M --no-fstab-update
