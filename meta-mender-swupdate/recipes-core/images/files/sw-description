software = {
    version = "@@SWUPDATE_SOFTWARE_VERSION@@";

    @@MACHINE@@ = {
        hardware-compatibility: [ "@@SWUPDATE_HARDWARE_VERSION@@" ];
        stable: {
            copy1: {
                images: (
                    {
                        filename = "main-image-@@MACHINE@@.ext4.gz";
                        type = "raw";
                        compressed = "zlib";
                        device = "/dev/@@OTA_PARTITION_A@@";
                    }
                );
                uboot: (
                    {
                        name = "rootpart";
                        value = "2";
                    }
                );
            }

            copy2: {
                images: (
                    {
                        filename = "main-image-@@MACHINE@@.ext4.gz";
                        type = "raw";
                        compressed = "zlib";
                        device = "/dev/@@OTA_PARTITION_B@@";
                    }
                );
                uboot: (
                    {
                        name = "rootpart";
                        value = "3";
                    }
                );
            }
        }
    }
}
