#!/bin/bash
#
# Mender Update Module "swu": deploy a SWUpdate .swu image through Mender.
#
# Mender owns deployment orchestration + the reboot. SWUpdate owns the
# actual update work: it writes the rootfs to the INACTIVE A/B slot (raw
# + zlib, per the .swu sw-description) and sets the U-Boot env variable
# "rootpart" to the new slot via its bootloader handler. Our boot.scr
# then boots /dev/vda${rootpart} on the next reboot.
#
# IMPORTANT: "query" states (ProvidePayloadFileSizes, NeedsArtifactReboot,
# SupportsRollback, ...) must print ONLY their answer on stdout -- mender
# parses stdout as the answer. So all human/diagnostic logging goes to
# STDERR via log() (still captured by mender as "Update Module output
# (stderr)"), and stdout carries only protocol answers / the installer's
# own output.
#
# ITERATION 1 (this file): buffered. Mender stages the payload to
# $FILES/files/*.swu before ArtifactInstall; we install it one-shot with
# "swupdate -i". SWUpdate does NOT need to be running as a daemon.
#
# ITERATION 2 (designed, see layer README): streaming. Implement the
# Download state, read the payload from Mender's stream named pipe, and
# pipe it straight into "swupdate-client -" over the IPC socket.

set -e

STATE="$1"
FILES="$2"

log() { echo "swu module: $*" >&2; }
booted_root() { findmnt -n -o SOURCE / 2>/dev/null || true; }

swu_path() {
    ls "$FILES"/files/*.swu 2>/dev/null | head -n1
}

# Pick the SWUpdate sw-description selection (stable,copyN) for the
# INACTIVE slot: copy1 writes slot A (vda2), copy2 writes slot B (vda3).
inactive_selection() {
    case "$(booted_root)" in
        *vda2) echo "stable,copy2" ;;   # running A -> install B
        *vda3) echo "stable,copy1" ;;   # running B -> install A
        *)     echo "stable,copy2" ;;   # unknown  -> default to B
    esac
}

case "$STATE" in

    ProvidePayloadFileSizes)
        # Buffered: we do not use the streaming (file-sizes) download path.
        # Must print exactly "No" on stdout.
        echo "No"
        ;;

    NeedsArtifactReboot)
        # SWUpdate flips "rootpart"; Mender must reboot for it to take effect.
        # Honour an optional "reboot" flag in the artifact meta-data; default
        # to Automatic. Answer ("Automatic"/"No") goes to stdout.
        reboot=$(jq -r '.reboot // "true"' "$FILES/header/meta-data" 2>/dev/null || echo "true")
        if [ "$reboot" = "false" ]; then
            echo "No"
        else
            echo "Automatic"
        fi
        ;;

    SupportsRollback)
        # Parity with the upstream 'swu' module: no Mender-driven rollback.
        echo "No"
        ;;

    ArtifactInstall)
        swu=$(swu_path)
        [ -n "$swu" ] || { log "ArtifactInstall: no .swu file in payload"; exit 1; }
        sel=$(inactive_selection)
        log "ArtifactInstall installing $(basename "$swu") (selection ${sel}, root=$(booted_root))"
        # No -H: SWUpdate reads board+revision from /etc/hwrevision and matches
        # the sw-description board section + its hardware-compatibility list.
        swupdate -i "$swu" -e "$sel"
        ;;

    ArtifactVerifyReboot)
        # Post-reboot: log the booted rootfs so the OTA flow is traceable; do
        # not hard-fail (no slot<->bank map to assert against).
        log "ArtifactVerifyReboot (booted root=$(booted_root))"
        ;;

    ArtifactCommit)
        log "ArtifactCommit (root=$(booted_root))"
        ;;

    ArtifactRollback)
        log "ArtifactRollback (root=$(booted_root))"
        ;;

    *)
        # Download / *Enter / *Leave / Cleanup etc.: no action in the buffered
        # iteration. Log to stderr only -- never pollute a query state's stdout.
        log "${STATE} (no-op)"
        ;;
esac

exit 0
