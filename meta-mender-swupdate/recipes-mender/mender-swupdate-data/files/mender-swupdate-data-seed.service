[Unit]
Description=Seed /var/lib/mender from the factory copy on first boot (persistent Mender state)
DefaultDependencies=no
After=var-lib-mender.mount
Requires=var-lib-mender.mount
# vda4 mounts directly at /var/lib/mender; on first boot it is empty (no
# device_type). Populate it from the build-time factory copy. Runs once.
ConditionPathExists=!/var/lib/mender/device_type
Before=mender-data-dir.service mender-authd.service mender-updated.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'cp -a /usr/lib/mender-factory/. /var/lib/mender/'
ExecStartPost=/bin/chmod 0700 /var/lib/mender

[Install]
WantedBy=mender-authd.service mender-updated.service
