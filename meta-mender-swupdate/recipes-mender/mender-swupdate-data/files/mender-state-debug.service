[Unit]
Description=DEBUG: log mender persistent-state mount + store on each boot
After=var-lib-mender.mount data.mount mender-swupdate-data-seed.service
Before=mender-authd.service mender-updated.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo "MENDER-DEBUG mounts:"; grep -E "mender| /data " /proc/mounts; echo "MENDER-DEBUG mender.conf (/etc):"; cat /etc/mender/mender.conf 2>&1; echo "MENDER-DEBUG DataStore grep:"; grep -rni "datastore\|RootfsPart\|/data" /etc/mender/ 2>&1; echo "MENDER-DEBUG find /var/lib/mender:"; find /var/lib/mender -maxdepth 3 2>&1; echo "MENDER-DEBUG find /data:"; find /data -maxdepth 3 2>&1; echo "MENDER-DEBUG existing mender-store anywhere:"; find / -xdev \( -name "mender-store*" -o -name "*.mdb" \) 2>/dev/null'

[Install]
WantedBy=mender-updated.service
