[Unit]
Description=DEBUG: log mender persistent-state mount + store on each boot
After=var-lib-mender.mount mender-swupdate-data-seed.service
Before=mender-authd.service mender-updated.service
DefaultDependencies=no

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'echo "MENDER-DEBUG mounts:"; grep -E "mender|vda4" /proc/mounts; echo "MENDER-DEBUG find /var/lib/mender:"; find /var/lib/mender -maxdepth 2 2>&1; echo "MENDER-DEBUG factory:"; find /usr/lib/mender-factory -maxdepth 2 2>&1'

[Install]
WantedBy=mender-updated.service
