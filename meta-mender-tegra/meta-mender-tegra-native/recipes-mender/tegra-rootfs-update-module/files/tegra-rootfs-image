#!/bin/sh
# Mender update module for Tegra A/B rootfs updates.
#
# Must parse and run under busybox ash: this layer targets images such as
# core-image-minimal where /bin/sh is busybox and bash is not installed. Do not
# use 'var+=' to append - ash parses that as a command name, so it fails
# silently and leaves the variable empty.
#
# Unlike the stock rootfs-image module this talks to the BSP directly:
#
#   nvbootctrl -t rootfs        which slot is running, and slot verification
#   /dev/disk/by-partlabel/APP  the rootfs partitions, named by the BSP layout
#   mender-flash                sparse-aware write to the passive slot
#   oe4t-set-uefi-OSIndications arm the staged UEFI capsule
#
# There is no fw_printenv/fw_setenv, no upgrade_available, no parsing of
# RootfsPartA/B out of mender.conf, and no Mender state scripts.
#
# Slot switching is performed by the UEFI capsule, not by nvbootctrl. Applying a
# capsule writes firmware into the *inactive* boot chain and then makes that
# chain active, and rootfs slots are paired to bootloader slots, so the rootfs
# follows. Calling set-active-boot-slot as well would make the capsule target
# the wrong chain, so it is used only to undo a switch during rollback.
#
# The module runs in two contexts, and behaves differently in each:
#
#   rootfs    the ordinary case. / is one of the two slots, and nvbootctrl must
#             agree about which one. Writing the running slot would destroy the
#             system mid-update, so a disagreement is fatal.
#
#   recovery  running from the recovery partition's ramdisk. / is neither slot,
#             which is precisely why both of them can be written. The active
#             slot is then whichever one the boot chain points at, and the
#             assertion is inverted: / must NOT be a slot.
#
# The recovery context is identified by a marker file that only the recovery
# image ships, never inferred from a failed lookup.

set -ue

STATE="$1"
FILES="$2"

# Overridable only so the module can be exercised off-target; the defaults are
# what runs on the device.
ESP_MOUNT="${TEGRA_ESP_MOUNT:-/boot/efi}"
ESP_CAPSULE_DIR="${TEGRA_ESP_CAPSULE_DIR:-${ESP_MOUNT}/EFI/UpdateCapsule}"
UEFI_COMMON_FUNC="${TEGRA_UEFI_COMMON_FUNC:-/usr/bin/uefi_common.func}"
PARTLABEL_DIR="${TEGRA_PARTLABEL_DIR:-/dev/disk/by-partlabel}"
PROC_MOUNTS="${TEGRA_PROC_MOUNTS:-/proc/mounts}"
ESP_CAPSULE="${ESP_CAPSULE_DIR}/TEGRA_BL.Cap"
CAPSULE_STASH="${FILES}/tmp/tegra-bl.cap"
ORIG_SLOT_FILE="${FILES}/tmp/orig-slot"
# Which slot this deployment is writing. Recorded separately from orig-slot
# because rollback has to be able to re-flag it unbootable without recomputing
# it from a slot mapping that may have moved on.
TARGET_SLOT_FILE="${FILES}/tmp/target-slot"
# Shipped only by the recovery image. Its presence is what selects the recovery
# context; nothing is inferred from a lookup that happened to fail.
RECOVERY_MARKER="${TEGRA_RECOVERY_MARKER:-/etc/tegra-mender-recovery}"
# Mender's persistent configuration, on the data partition. Carries RootfsPartA
# and RootfsPartB, which is the last resort for resolving the slots when the
# partlabel symlinks are absent.
PERSISTENT_CONF="${TEGRA_PERSISTENT_CONF:-/var/lib/mender/mender.conf}"
EFIVARS_DIR="${TEGRA_EFIVARS_DIR:-/sys/firmware/efi/efivars}"
# Persistent, and deliberately not under $FILES: tegra-rootfs-verify reads it on
# the next boot to decide whether the running slot may be marked good yet.
UPDATE_PENDING="${TEGRA_UPDATE_PENDING:-/var/lib/mender/tegra-update-pending}"
ROOTFS_STATUS_GUID="781e084c-a330-417c-b678-38e696380cb9"
EFI_GLOBAL_GUID="8be4df61-93ca-11d2-aa0d-00e098032b8c"

# Progress goes to stderr, which mender folds into the deployment log. Without
# this a module that dies mid-state leaves nothing behind saying how far it got,
# and the deployment log is the only evidence available once a bad update has
# made the device unreachable.
log() {
    echo "tegra-rootfs-image[$STATE]: $*" 1>&2
}

# Which context are we running in? See the header comment.
running_context() {
    if [ -e "$RECOVERY_MARKER" ]; then
        echo "recovery"
    else
        echo "rootfs"
    fi
}

# Resolve a GPT partition label to a device node.
#
# The partlabel symlinks come from udev, and the recovery system is an
# initramfs with no udev, so /dev/disk/by-partlabel does not exist there at
# all. Fall back to reading the labels straight out of the partition table, and
# finally to the RootfsPartA/RootfsPartB that meta-mender writes into the
# persistent configuration on the data partition.
resolve_partlabel() {
    _want="$1"
    if [ -e "${PARTLABEL_DIR}/${_want}" ]; then
        readlink -f "${PARTLABEL_DIR}/${_want}"
        return 0
    fi
    _dev=$(lsblk -n -r -o NAME,PARTLABEL 2>/dev/null \
           | awk -v w="$_want" '$2 == w { print "/dev/" $1; exit }')
    if [ -z "$_dev" ]; then
        _dev=$(blkid -t "PARTLABEL=${_want}" -o device 2>/dev/null | head -n 1)
    fi
    if [ -z "$_dev" ] && [ -r "$PERSISTENT_CONF" ]; then
        case "$_want" in
            APP)   _key="RootfsPartA" ;;
            APP_b) _key="RootfsPartB" ;;
            *)     _key="" ;;
        esac
        if [ -n "$_key" ]; then
            _dev=$(sed -n 's/.*"'"$_key"'"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
                   "$PERSISTENT_CONF" | head -n 1)
        fi
    fi
    [ -n "$_dev" ] || return 1
    readlink -f "$_dev"
}

# Slot number (0/1) -> the real device node for that slot's rootfs. The BSP
# names the partitions, but the symlink is resolved before use: the stock
# rootfs-image module does the same before handing a path to mender-flash.
# The disk / was mounted from. On a board carrying two Tegra layouts the partition
# labels are duplicated, so the by-partlabel symlinks point at whichever disk udev
# settled last. Empty when it cannot be worked out, for instance from a recovery
# ramdisk, and callers then fall back to the symlink.
booted_disk() {
    _bd_root=$(readlink -f "$(awk '$2 == "/" { print $1; exit }' "$PROC_MOUNTS")" 2>/dev/null)
    _bd_part=${_bd_root##*/}
    [ -n "$_bd_part" ] || return 1
    _bd_disk=$(readlink -f "/sys/class/block/${_bd_part}/..") || return 1
    _bd_disk=${_bd_disk##*/}
    [ -n "$_bd_disk" ] && [ "$_bd_disk" != "block" ] || return 1
    echo "$_bd_disk"
}

# Prefer the label as it appears on the booted disk, and fall back to the symlink.
# assert_slot_mapping_sane still cross-checks the result against the mounted root,
# so a wrong answer is refused either way; this makes the right answer the one that
# is normally used, rather than relying on udev having settled favourably.
slot_device() {
    case "$1" in
        0) _lbl="APP" ;;
        1) _lbl="APP_b" ;;
        *) echo "unexpected rootfs slot '$1'" 1>&2; return 1 ;;
    esac
    # Prefer the label as it appears on the disk / was mounted from: on a board
    # with two Tegra layouts the labels are duplicated. In the recovery context
    # there is no such disk to derive from, and resolve_partlabel's own chain
    # (udev symlinks, then lsblk, then blkid, then the persistent config) takes
    # over, which is what that context needs.
    if _disk=$(booted_disk); then
        _on_disk=$(lsblk -n -r -o NAME,PARTLABEL "/dev/$_disk" 2>/dev/null \
                   | awk -v l="$_lbl" '$2 == l { print "/dev/" $1; exit }')
        if [ -n "$_on_disk" ]; then
            echo "$_on_disk"
            return 0
        fi
    fi
    _d=$(resolve_partlabel "$_lbl") || {
        echo "cannot resolve the partition labelled '$_lbl'" 1>&2
        return 1
    }
    echo "$_d"
}

# Device the root filesystem is actually mounted from, canonicalised the same
# way slot_device output is, so the two can be compared.
#
# Only the known symlink forms are resolved. Anything else is passed through
# untouched, which is what the stock rootfs-image module does in resolve_rootfs()
# and for the same reason. Canonicalising unconditionally is wrong here: a
# ramdisk root appears in /proc/mounts as the bare word "rootfs", and
# `readlink -f rootfs` is not a no-op. busybox returns empty, GNU coreutils
# returns "$PWD/rootfs" because the module runs with its cwd inside mender's
# payload directory. Neither is a device, so the comparison happened to give the
# right answer either way, but only by accident, and it is the same
# host-versus-target divergence that made `od -j` misread an efivar.
root_device() {
    _r=$(while read -r dev mnt _rest; do
             [ "$mnt" = "/" ] && { echo "$dev"; break; }
         done < "$PROC_MOUNTS")
    case "$_r" in
        /dev/root|/dev/disk/by-partlabel/*|/dev/disk/by-partuuid/*|/dev/disk/by-uuid/*)
            readlink -f "$_r"
            ;;
        *)
            echo "$_r"
            ;;
    esac
}

# The ESP of the disk the running system booted from.
#
# A board can carry more than one Tegra layout, an NVMe and an SD card being the
# obvious pair, and then every name the ESP could be pinned by is duplicated:
# both carry the partition label 'esp', both carry the same filesystem UUID
# because both were written from the same esp.img, and the partition UUIDs are
# unique but only assigned at flash time. So /dev/disk/by-partlabel/esp points
# at whichever disk udev settled last, and nothing puts the ESP in fstab at all:
# the mount comes from systemd's gpt-auto generator, which picks one.
#
# Staging the capsule on the other disk's ESP arms nothing. UEFI reads the
# capsule from the medium it booted, so the slot switch simply does not happen,
# and the deployment fails a reboot later with a slot mismatch.
#
# The disk the running rootfs came from is the only trustworthy statement of
# which medium UEFI booted, which is the same reasoning assert_slot_mapping_sane
# already applies when it trusts the mounted root over the partition labels.
esp_device() {
    # In the rootfs context the mounted root names the booted disk. In the
    # recovery context / is a ramdisk and names nothing, so take the disk from a
    # rootfs slot instead: both slots live on the medium the recovery system was
    # booted from, which is the medium UEFI will read the capsule from.
    if [ "$(running_context)" = "recovery" ]; then
        _rp=$(slot_device "$(current_slot)") || return 1
    else
        _rp=$(root_device) || return 1
    fi
    _rp=${_rp##*/}
    [ -n "$_rp" ] || return 1
    _disk=$(readlink -f "/sys/class/block/${_rp}/..") || return 1
    _disk=${_disk##*/}
    [ -n "$_disk" ] && [ "$_disk" != "block" ] || return 1

    _esp=$(lsblk -n -r -o NAME,PARTLABEL "/dev/$_disk" 2>/dev/null \
           | awk '$2 == "esp" { print "/dev/" $1; exit }')
    if [ -z "$_esp" ]; then
        # No lsblk, or a build of it without PARTLABEL. The recovery system is an
        # initramfs and is exactly this case.
        for _cand in /sys/class/block/"$_disk"/"$_disk"*; do
            [ -e "$_cand/partition" ] || continue
            _n=${_cand##*/}
            [ "$(blkid -o value -s PARTLABEL "/dev/$_n" 2>/dev/null)" = "esp" ] || continue
            _esp="/dev/$_n"
            break
        done
    fi
    [ -n "$_esp" ] || return 1
    echo "$_esp"
}

# Device currently backing $ESP_MOUNT, empty when nothing is mounted there.
esp_mounted_device() {
    _m=$(while read -r dev mnt _rest; do
             [ "$mnt" = "$ESP_MOUNT" ] && { echo "$dev"; break; }
         done < "$PROC_MOUNTS")
    [ -n "$_m" ] || return 0
    readlink -f "$_m"
}

# Make $ESP_MOUNT the ESP of the booted disk, remounting if something else got
# there first. Returns non-zero when that cannot be arranged, so the caller
# decides whether it is fatal: it is when a capsule is about to be staged, and
# it is not when an old one is merely being cleaned up.
ensure_esp_mounted() {
    _want=$(esp_device) || {
        # Fall back to whatever is mounted rather than refusing. That is what this
        # module did before the derivation existed, it is correct on a board with
        # only one ESP, and failing here would turn an environment the derivation
        # cannot read into a failed deployment. Only an unmounted $ESP_MOUNT is
        # fatal, which was the guard before.
        _have=$(esp_mounted_device)
        if [ -n "$_have" ]; then
            log "cannot determine the booted disk's ESP; keeping $ESP_MOUNT as mounted ($_have)"
            return 0
        fi
        log "cannot determine the ESP of the booted disk and nothing is mounted at $ESP_MOUNT"
        return 1
    }
    _have=$(esp_mounted_device)
    if [ "$_have" = "$_want" ]; then
        log "ESP $_want mounted at $ESP_MOUNT"
        return 0
    fi
    if [ -n "$_have" ]; then
        log "$ESP_MOUNT is $_have but the booted disk's ESP is $_want; remounting"
        umount "$ESP_MOUNT" || {
            log "cannot unmount $ESP_MOUNT"
            return 1
        }
    else
        log "nothing mounted at $ESP_MOUNT; mounting the booted disk's ESP $_want"
    fi
    mkdir -p "$ESP_MOUNT"
    mount "$_want" "$ESP_MOUNT" || {
        log "cannot mount $_want at $ESP_MOUNT"
        return 1
    }
    return 0
}

# Never write to the slot we are running from, and never write on a guess.
#
# In the rootfs context nvbootctrl and the mounted root must agree about which
# slot is active; if they do not, the bookkeeping is wrong and writing would
# destroy the running system mid-update. The stock rootfs-image module guards
# the same way, via check_device_matches_root.
#
# In the recovery context the assertion is inverted. / is a ramdisk, so it must
# be neither slot. A / that *is* a slot here means the marker is lying about
# where we are, which is worse than either context on its own, so it is fatal.
assert_slot_mapping_sane() {
    _ctx=$(running_context)
    _cur=$(current_slot) || {
        log "FATAL: nvbootctrl could not report the current rootfs slot"
        return 1
    }
    case "$_cur" in
        0|1) ;;
        *) log "FATAL: nvbootctrl reported an unusable current slot '$_cur'"; return 1 ;;
    esac

    _act=$(slot_device "$_cur") || return 1
    _pas=$(slot_device "$(passive_slot)") || return 1
    _root=$(root_device)

    if [ "$_act" = "$_pas" ]; then
        log "FATAL: both slots resolved to the same device $_act"
        return 1
    fi

    if [ "$_ctx" = "recovery" ]; then
        if [ -n "$_root" ] && { [ "$_root" = "$_act" ] || [ "$_root" = "$_pas" ]; }; then
            log "FATAL: recovery context, but / is mounted from slot device $_root"
            return 1
        fi
        # The boot chain is the only statement of which slot is 'active' here,
        # so cross-check nvbootctrl against the firmware variable it derives
        # from rather than trusting a single source.
        _chain=$(bootchain_os_slot)
        if [ -n "$_chain" ] && [ "$_chain" != "$_cur" ]; then
            log "FATAL: nvbootctrl says slot $_cur but BootChainOsCurrent says $_chain"
            return 1
        fi
        log "recovery context: active slot $_cur ($_act), target $_pas, / is $_root"
        return 0
    fi

    if [ -z "$_root" ]; then
        log "FATAL: cannot determine the root device from $PROC_MOUNTS"
        return 1
    fi
    if [ "$_act" != "$_root" ]; then
        log "FATAL: nvbootctrl says the active slot is $_act but / is mounted from $_root"
        return 1
    fi
    if [ "$_pas" = "$_root" ]; then
        log "FATAL: computed passive slot $_pas is the mounted root; refusing to write"
        return 1
    fi
    log "slot mapping sane: active $_act, passive $_pas"
    return 0
}

# The UEFI boot chain currently selected, as a slot number, or empty if the
# variable cannot be read. efivarfs prefixes the value with a 4-byte attribute
# word, so the payload starts at byte 5.
#
# Skip those four bytes with dd, not with 'od -j'. The busybox od on the target
# silently ignores -j and reports the first byte instead, which is the low byte
# of the attribute word: 6 for this variable, since L4TLauncher writes it with
# BOOTSERVICE_ACCESS|RUNTIME_ACCESS. That reads as a plausible-looking slot
# number and made the module refuse every deployment with "nvbootctrl says slot
# 0 but BootChainOsCurrent says 6". Note the busybox on the *build host* does
# honour -j, so this cannot be reproduced off-target.
bootchain_os_slot() {
    _v="${EFIVARS_DIR}/BootChainOsCurrent-${ROOTFS_STATUS_GUID}"
    [ -r "$_v" ] || return 0
    dd if="$_v" bs=1 skip=4 count=1 2>/dev/null | od -An -tu1 | tr -d ' \n'
}

slot_letter() {
    case "$1" in
        0) echo "A" ;;
        1) echo "B" ;;
        *) echo "unexpected rootfs slot '$1'" 1>&2; return 1 ;;
    esac
}

current_slot() {
    nvbootctrl -t rootfs get-current-slot
}

passive_slot() {
    if [ "$(current_slot)" = "0" ]; then echo 1; else echo 0; fi
}

# Write a slot's RootfsStatusSlot{A,B} efivar. 0x00 is a normal, bootable slot;
# 0xff tells UEFI the slot is unusable, so it boots the partner instead.
set_rootfs_status() {
    _slot="$1"
    _val="$2"
    _rc=0
    # uefi_common.func predates any use of 'set -u'. set_efi_var reads a fourth
    # positional argument (write_once) and $RUNTIME_DIRECTORY, and neither is
    # guaranteed to be set when we call it. Relax nounset around the call rather
    # than patching the BSP, and pass the fourth argument explicitly: empty means
    # "not write-once", which is what we want since the status must be
    # overwritten every time.
    set +u
    . "$UEFI_COMMON_FUNC"
    set_efi_var "RootfsStatusSlot$(slot_letter "$_slot")" "$ROOTFS_STATUS_GUID" \
        "$_val" "" || _rc=$?
    set -u
    return "$_rc"
}

# The passive slot may still be flagged unbootable, either from an earlier failed
# update or from the write below. UEFI refuses to boot it until this is cleared.
clear_unbootable() {
    set_rootfs_status "$1" "\x00\x00\x00\x00"
}

mark_unbootable() {
    set_rootfs_status "$1" "\xff\x00\x00\x00"
}

# Undo "arm the capsule". Deleting the staged file is not enough on its own:
# OsIndications still asks the firmware to run a capsule update on the next
# boot, and an aborted update must not leave that request standing.
disarm_capsule() {
    _rc=0
    set +u
    . "$UEFI_COMMON_FUNC"
    set_efi_var "OsIndications" "$EFI_GLOBAL_GUID" \
        "\x00\x00\x00\x00\x00\x00\x00\x00" "" || _rc=$?
    set -u
    return "$_rc"
}

case "$STATE" in
    ProvidePayloadFileSizes)
        echo "Yes"
        ;;

    Download)
        echo "This module supports DownloadWithFileSizes only" 1>&2
        exit 1
        ;;

    DownloadWithFileSizes)
        assert_slot_mapping_sane || exit 1
        target="$(passive_slot)"
        target_dev="$(slot_device "$target")"

        # Remember the target before touching it, so a rollback can put its
        # unbootable flag back without having to recompute the slot mapping.
        mkdir -p "${FILES}/tmp"
        echo "$target" > "${TARGET_SLOT_FILE}.tmp"
        mv "${TARGET_SLOT_FILE}.tmp" "$TARGET_SLOT_FILE"
        sync

        # From the first byte written until ArtifactInstall clears this again,
        # the slot holds a torn filesystem. Leaving it flagged bootable would let
        # UEFI fall back onto a half-written rootfs if the running slot failed
        # during the download.
        log "flagging slot $target unbootable while it is being written"
        mark_unbootable "$target"

        got_rootfs=0
        got_capsule=0
        while true; do
            line="$(cat stream-next)"
            [ -n "$line" ] || break

            # "<path> <size>"; the path's basename identifies the payload.
            path="$(echo "$line" | cut -d' ' -f1)"
            size="$(echo "$line" | cut -d' ' -f2)"
            if [ -z "$path" ] || [ -z "$size" ]; then
                echo "Cannot parse line from stream-next, got: $line" 1>&2
                exit 1
            fi

            # Match both payloads explicitly. A catch-all that treats "not a
            # capsule" as "the rootfs" would flash a stray file straight onto
            # the partition, and would let a second rootfs payload silently
            # overwrite the first.
            case "$(basename "$path")" in
                *.cap)
                    if [ "$got_capsule" = 1 ]; then
                        echo "Artifact carries more than one .cap payload" 1>&2
                        exit 1
                    fi
                    log "stashing capsule ($size bytes)"
                    mkdir -p "${FILES}/tmp"
                    cat "$path" > "$CAPSULE_STASH"
                    got_capsule=1
                    ;;
                *.ext4)
                    if [ "$got_rootfs" = 1 ]; then
                        echo "Artifact carries more than one rootfs payload" 1>&2
                        exit 1
                    fi
                    log "writing rootfs ($size bytes) to $target_dev"
                    mender-flash --input-size "$size" --input "$path" \
                        --output "$target_dev"
                    log "rootfs write finished"
                    got_rootfs=1
                    ;;
                *)
                    echo "Unexpected payload '$(basename "$path")': this module" \
                         "takes exactly one .ext4 rootfs and one .cap capsule" 1>&2
                    exit 1
                    ;;
            esac
        done

        if [ "$got_rootfs" != 1 ]; then
            echo "Artifact contained no rootfs payload" 1>&2
            exit 1
        fi
        if [ "$got_capsule" != 1 ]; then
            echo "Artifact contained no .cap payload; the slot switch is" \
                 "performed by the UEFI capsule, so it is required" 1>&2
            exit 1
        fi
        sync
        ;;

    ArtifactInstall)
        # Remember where we came from, so rollback after the reboot knows which
        # slot to go back to. $FILES/tmp survives the reboot.
        assert_slot_mapping_sane || exit 1
        _cur="$(current_slot)"
        _passive="$(passive_slot)"
        log "current slot $_cur, arming slot $_passive"
        echo "$_cur" > "${ORIG_SLOT_FILE}.tmp"
        mv "${ORIG_SLOT_FILE}.tmp" "$ORIG_SLOT_FILE"
        sync

        log "clearing any unbootable flag on slot $_passive"
        clear_unbootable "$_passive"

        # The ESP has to be mounted, and it has to be the one belonging to the
        # disk this system booted from, or the capsule lands somewhere UEFI
        # never reads and no switch is armed.
        if ! ensure_esp_mounted; then
            log "FATAL: no usable ESP at $ESP_MOUNT; the capsule would arm nothing"
            exit 1
        fi

        log "staging capsule to $ESP_CAPSULE"
        mkdir -p "$ESP_CAPSULE_DIR"
        cp "$CAPSULE_STASH" "$ESP_CAPSULE"
        sync

        # Hold off tegra-rootfs-verify until this update has a verdict. Without
        # this the next boot marks the new slot good before mender commits, and
        # the rollback is gone.
        #
        # The marker names the slot the update is aiming at, and the verifier
        # only stands down while that slot is the one running. A marker that
        # outlives its deployment then cannot silently stop verification of some
        # unrelated slot forever, which with RootfsRetryCountMax=1 would condemn
        # it after a single boot.
        log "marking update pending ($UPDATE_PENDING), target slot $_passive"
        echo "$_passive" > "${UPDATE_PENDING}.tmp"
        mv "${UPDATE_PENDING}.tmp" "$UPDATE_PENDING"
        sync

        log "arming OsIndications"
        oe4t-set-uefi-OSIndications
        log "done; the capsule will switch the boot chain on the next reboot"
        ;;

    NeedsArtifactReboot)
        echo "Automatic"
        ;;

    SupportsRollback)
        echo "Yes"
        ;;

    ArtifactVerifyReboot)
        # The capsule should have switched us to the other slot.
        [ -f "$ORIG_SLOT_FILE" ] || { echo "missing $ORIG_SLOT_FILE" 1>&2; exit 1; }
        orig="$(cat "$ORIG_SLOT_FILE")"
        cur="$(current_slot)"
        if [ "$cur" = "$orig" ]; then
            log "still on slot $orig after reboot; the capsule did not switch the boot chain"
            exit 1
        fi
        log "booted slot $cur as expected (was $orig)"
        # The boot chain switched, but that is only half of the claim. Confirm
        # that / really is this slot's partition before the commit blesses the
        # pairing; otherwise a chain that switched without the rootfs following
        # goes unnoticed until the next update writes over the running system.
        assert_slot_mapping_sane || exit 1
        ;;

    ArtifactCommit)
        # Committing means "the slot I am running from works". From the recovery
        # system nothing has booted the new slot yet, so there is nothing to
        # attest to and nvbootctrl verify would bless the wrong thing. An
        # install started in recovery is committed after the reboot, by the
        # client in the slot it just wrote.
        if [ "$(running_context)" = "recovery" ]; then
            log "FATAL: refusing to commit from the recovery system; the update" \
                "must be committed by the slot it installed, after the reboot"
            exit 1
        fi
        # Marks the running bootloader and rootfs slot good, and resets the
        # rootfs retry counter. Without this UEFI reverts on a later boot.
        log "verifying slot $(current_slot)"
        nvbootctrl verify
        rm -f "$UPDATE_PENDING"
        sync
        log "slot verified, update no longer pending"
        ;;

    ArtifactRollback)
        # Remove a staged-but-unapplied capsule unconditionally, before anything
        # else can fail. Leaving it behind is the dangerous outcome: the next
        # reboot would switch to the slot being abandoned.
        # Best effort: an unconsumed capsule sits on the booted disk's ESP, which
        # may not be what is mounted now. Not fatal, the update already has a
        # verdict by this point.
        ensure_esp_mounted || log "continuing cleanup against $ESP_MOUNT as mounted"
        if [ -e "$ESP_CAPSULE" ]; then
            log "removing staged capsule $ESP_CAPSULE"
            rm -f "$ESP_CAPSULE"
            sync
        else
            log "no staged capsule to remove"
        fi
        log "disarming OsIndications"
        disarm_capsule || log "WARNING: could not clear OsIndications"
        rm -f "$UPDATE_PENDING"
        sync

        # ArtifactInstall cleared the target's unbootable flag so the firmware
        # would accept it after the switch. If we are rolling back while still
        # in the recovery context, that switch never happened and the target
        # holds a torn filesystem, so the flag has to go back. Getting this
        # wrong is worse here than in the rootfs context: a device in recovery
        # usually got there because the *other* slot is unbootable too, so a
        # target left flagged bootable is the firmware's next choice, and it
        # would boot the half-written one instead of returning to recovery.
        #
        # Only in the recovery context. If we already rebooted into the target
        # then we are running from it, and flagging the running slot unbootable
        # would strand the device.
        if [ "$(running_context)" = "recovery" ] && [ -f "$TARGET_SLOT_FILE" ]; then
            _tgt=$(cat "$TARGET_SLOT_FILE")
            log "recovery context: re-flagging the half-written slot $_tgt unbootable"
            mark_unbootable "$_tgt" || log "WARNING: could not re-flag slot $_tgt"
        fi

        if [ ! -f "$ORIG_SLOT_FILE" ]; then
            log "no recorded original slot; nothing further to undo"
            exit 0
        fi
        orig="$(cat "$ORIG_SLOT_FILE")"
        cur="$(current_slot)"
        if [ "$cur" != "$orig" ]; then
            # The capsule already applied and we booted the new slot. Send the
            # boot chain back; the rootfs slot is paired to it and follows.
            log "on slot $cur, returning to $orig"
            nvbootctrl set-active-boot-slot "$orig"
        else
            log "still on the original slot $orig, no switch to undo"
        fi
        ;;

    ArtifactVerifyRollbackReboot)
        [ -f "$ORIG_SLOT_FILE" ] || { echo "missing $ORIG_SLOT_FILE" 1>&2; exit 1; }
        orig="$(cat "$ORIG_SLOT_FILE")"
        cur="$(current_slot)"
        if [ "$cur" != "$orig" ]; then
            log "FATAL: rollback aimed at slot $orig but booted slot $cur"
            exit 1
        fi
        log "back on slot $orig after rollback"
        ;;

    ArtifactFailure)
        # Belt and braces for the same hazard ArtifactRollback covers: if the
        # rollback state did not run, or ran and failed, a target whose
        # unbootable flag was cleared must not be left as the firmware's next
        # choice. Marking an already-unbootable slot unbootable is a no-op, so
        # doing this twice costs nothing.
        if [ "$(running_context)" = "recovery" ] && [ -f "$TARGET_SLOT_FILE" ]; then
            _tgt=$(cat "$TARGET_SLOT_FILE")
            log "recovery context: ensuring slot $_tgt is flagged unbootable"
            mark_unbootable "$_tgt" || log "WARNING: could not re-flag slot $_tgt"
        fi
        ;;

    Cleanup)
        rm -f "$CAPSULE_STASH"
        # Whatever happened above, mender is done with this deployment, so
        # nothing is awaiting a verdict any more. Dropping the marker here as
        # well covers the paths that reach ArtifactInstall but never reach
        # ArtifactCommit or ArtifactRollback, such as an aborted deployment.
        rm -f "$UPDATE_PENDING"
        sync
        log "cleaned up"
        ;;
esac
exit 0
