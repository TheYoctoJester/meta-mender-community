[Unit]
Description=Seed /data/mender from the rootfs on first boot (RAUC-persistent Mender state)
DefaultDependencies=no
After=data.mount
Requires=data.mount
# Run only on first boot, before anything else touches /data/mender.
ConditionPathExists=!/data/mender
# Must populate /data/mender before (a) meta-mender's mender-data-dir.service,
# which would otherwise mkdir an *empty* /data/mender first, and (b) the
# var-lib-mender.mount that bind-mounts /data/mender over /var/lib/mender.
# If an empty /data/mender wins that race, the bind-mount shadows the rootfs
# /var/lib/mender/device_type and the Mender client reports no device_type.
Before=var-lib-mender.mount mender-data-dir.service mender-authd.service mender-updated.service

[Service]
Type=oneshot
RemainAfterExit=yes
# At this point /var/lib/mender is still the rootfs copy (the bind-mount is
# ordered after us), so this captures device_type, mender.conf, etc.
ExecStart=/bin/cp -a /var/lib/mender /data/mender
ExecStartPost=/bin/chmod 0700 /data/mender

[Install]
WantedBy=mender-authd.service mender-updated.service
