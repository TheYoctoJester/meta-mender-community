From dcbc6ddc8bfe2e6d1e47378ffa39e313bfe93a48 Mon Sep 17 00:00:00 2001
From: tyj <tyj@x>
Date: Sat, 13 Jun 2026 18:04:01 +0000
Subject: [PATCH 3/6] board/qemu-arm: register FWU image types with FMP

Upstream-Status: Pending

Signed-off-by: meta-mender-fwu <noreply@example.com>
---
 board/emulation/qemu-arm/qemu-arm.c | 24 ++++++++++++++++++++++++
 1 file changed, 24 insertions(+)

diff --git a/board/emulation/qemu-arm/qemu-arm.c b/board/emulation/qemu-arm/qemu-arm.c
index 251070ec..ba0bdae8 100644
--- a/board/emulation/qemu-arm/qemu-arm.c
+++ b/board/emulation/qemu-arm/qemu-arm.c
@@ -32,6 +32,14 @@ DECLARE_GLOBAL_DATA_PTR;
 	EFI_GUID(0x058b7d83, 0x50d5, 0x4c47, 0xa1, 0x95, \
 		 0x60, 0xd8, 0x6a, 0xd3, 0x41, 0xc4)
 
+#define META_TYJ_FWU_KERNEL_IMAGE_GUID \
+	EFI_GUID(0xfd2ba1cf, 0x0f04, 0x4f44, 0x8e, 0x7c, \
+		 0x44, 0xe9, 0xc8, 0xc5, 0xcd, 0x5f)
+
+#define META_TYJ_FWU_ROOTFS_IMAGE_GUID \
+	EFI_GUID(0xf1d3e7a0, 0x5f6e, 0x4b8c, 0x9d, 0x2e, \
+		 0x1a, 0x3b, 0x5c, 0x7d, 0x9e, 0x2f)
+
 #ifdef CONFIG_ARM64
 #include <asm/armv8/mmu.h>
 
@@ -50,6 +58,22 @@ struct efi_fw_image fw_images[] = {
 		.image_index = 1,
 	},
 #endif
+#if IS_ENABLED(CONFIG_FWU_MULTI_BANK_UPDATE)
+	{
+		/* meta-mender-fwu kernel image type, per FWU metadata.
+		 * image_index must be unique across the whole fw_images[]
+		 * array — the UBOOT entry above already uses 1. */
+		.image_type_id = META_TYJ_FWU_KERNEL_IMAGE_GUID,
+		.fw_name = u"FWU-Kernel",
+		.image_index = 2,
+	},
+	{
+		/* meta-mender-fwu rootfs image type, per FWU metadata */
+		.image_type_id = META_TYJ_FWU_ROOTFS_IMAGE_GUID,
+		.fw_name = u"FWU-Rootfs",
+		.image_index = 3,
+	},
+#endif
 };
 
 struct efi_capsule_update_info update_info = {
