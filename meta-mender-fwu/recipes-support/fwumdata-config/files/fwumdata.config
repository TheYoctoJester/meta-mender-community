# yafwumdata / libfwumdata config: device, offset, mdata_size, erase_size.
#
# 0xB0 = 176 bytes = sizeof(fwu_mdata) for our build (V1, 2 banks, 2 images).
# 0x1000 erase size is the GPT-block-write granularity; conservative.
/dev/disk/by-partlabel/fwu-mdata-pri    0x0    0xB0    0x1000
/dev/disk/by-partlabel/fwu-mdata-sec    0x0    0xB0    0x1000
