+#include <mender-update/daemon/ipc/server.hpp>
+
+#include <cstdlib>
+#include <string>
+
+#include <cxxabi.h>
+
+#include <common/error.hpp>
+#include <common/expected.hpp>
+#include <common/log.hpp>
+#include <common/platform/dbus.hpp>
+
+namespace mender {
+namespace update {
+namespace daemon {
+namespace ipc {
+
+namespace dbus = mender::common::dbus;
+namespace error = mender::common::error;
+namespace expected = mender::common::expected;
+namespace log = mender::common::log;
+
+using namespace std;
+
+UpdateManagerDBus::UpdateManagerDBus(events::EventLoop &loop) :
+	current_state_("unknown"),
+	dbus_server_(loop, "io.mender.UpdateManager") {
+}
+
+string UpdateManagerDBus::DemangleStateName(const string &mangled) {
+	int status = 0;
+	char *demangled = abi::__cxa_demangle(mangled.c_str(), nullptr, nullptr, &status);
+	string result;
+	if (status == 0 && demangled) {
+		result = demangled;
+		// Extract class name after last "::"
+		auto pos = result.rfind("::");
+		if (pos != string::npos) {
+			result = result.substr(pos + 2);
+		}
+		free(demangled);
+	} else {
+		// Fallback: return the raw name
+		result = mangled;
+	}
+	return result;
+}
+
+error::Error UpdateManagerDBus::Listen() {
+	auto dbus_obj = make_shared<dbus::DBusObject>("/io/mender/UpdateManager");
+	dbus_obj->AddMethodHandler<expected::ExpectedString>(
+		"io.mender.Update1", "GetCurrentState", [this]() {
+			return current_state_;
+		});
+	return dbus_server_.AdvertiseObject(dbus_obj);
+}
+
+void UpdateManagerDBus::EmitStateChanged(const string &mangled_name) {
+	current_state_ = DemangleStateName(mangled_name);
+	auto err = dbus_server_.EmitSignal<string>(
+		"/io/mender/UpdateManager",
+		"io.mender.Update1",
+		"StateChanged",
+		current_state_);
+	if (err != error::NoError) {
+		log::Error("Failed to emit StateChanged signal: " + err.String());
+	}
+}
+
+} // namespace ipc
+} // namespace daemon
+} // namespace update
+} // namespace mender
