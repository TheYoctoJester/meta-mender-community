 		vector<State<ContextType, EventType> *> to_run;
@@ -222,7 +227,11 @@ private:
 
 		if (!to_run.empty()) {
 			for (auto &state : to_run) {
-				log::Trace("Entering state " + common::BestAvailableTypeName(*state));
+				auto state_name = common::BestAvailableTypeName(*state);
