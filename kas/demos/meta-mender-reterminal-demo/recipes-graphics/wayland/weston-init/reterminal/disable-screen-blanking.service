[Unit]
Description=Disable kernel and VT screen blanking for kiosk mode
After=systemd-logind.service
Before=weston.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c '\
    echo 0 > /sys/module/kernel/parameters/consoleblank; \
    echo -ne "\033[9;0]" > /dev/tty0 2>/dev/null; \
    echo -ne "\033[14;0]" > /dev/tty0 2>/dev/null; \
    echo -ne "\033[9;0]" > /dev/tty1 2>/dev/null; \
    echo -ne "\033[14;0]" > /dev/tty1 2>/dev/null; \
    true'

[Install]
WantedBy=multi-user.target
