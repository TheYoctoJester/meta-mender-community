[Unit]
Description=Disable kernel console blanking and DPMS
DefaultDependencies=no
After=sysinit.target
Before=weston.service

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'echo 0 > /sys/module/kernel/parameters/consoleblank; for tty in /dev/tty0 /dev/tty1 /dev/tty7; do [ -e "$tty" ] && setterm -blank 0 -powerdown 0 > "$tty" 2>/dev/null; done; true'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
