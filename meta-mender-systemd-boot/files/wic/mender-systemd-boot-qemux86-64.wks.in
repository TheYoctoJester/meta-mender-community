# Mender + systemd-boot A/B disk layout for qemux86-64 (wrynose).
#
# Boot chain at runtime:
#   QEMU -> OVMF (UEFI) -> systemd-boot (EFI/BOOT/BOOTX64.EFI, firmware
#   removable-media fallback) -> Type #1 boot entry (bzImage + initrd) -> kernel
#
# GPT layout on an AHCI disk (/dev/sda), total ~2.37 GB:
#   1. ESP / boot     256 MB  systemd-boot installed by the bootimg_efi
#                              plugin, plus the two boot entries, loader.conf
#                              and per-slot kernel+initrd staged by
#                              mender-systemd-boot-ab.bbclass.
#   2. mender-rootfsa 1024 MB rootfs slot A (populated at build)
#   3. mender-rootfsb 1024 MB rootfs slot B (populated identically at build
#                              so a first boot from either slot works)
#   4. mender-data      64 MB persistent /data, bind-mounted over
#                              /var/lib/mender by the shim's mount unit so
#                              the Mender state DB and agent key survive the
#                              rootfs swap of an OTA.
#
# The rootfs partitions exclude boot/ -- the ESP is mounted at /boot, and the
# kernel/initrd that systemd-boot loads live on the ESP, not in the rootfs.
#
# (Single-line `part` entries: wic's ksparser uses shlex which can choke on
#  backslash line continuations under recent Python.)

# The ESP mountpoint is /boot/efi (matched by mender-systemd-boot-ab.bbclass's
# fstab line). wic still emits a UUID fstab entry for it despite
# --no-fstab-update, so the mountpoint here MUST be /boot/efi too: if it were
# /boot, the ESP would be mounted at both /boot (wic) and /boot/efi (this
# layer), and because the ESP is FAT (case-insensitive) the /boot/efi mount
# would shadow the /boot/EFI directory, so the shim's writes would never reach
# the ESP root systemd-boot reads -- silently breaking the A/B slot flip.
bootloader --ptable gpt --timeout=5
part /boot/efi --source bootimg_efi --sourceparams="loader=${EFI_PROVIDER}" --ondisk sda --label boot --part-name=ESP --part-type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B --align 1024 --fixed-size 256M --active --use-uuid --no-fstab-update
part / --source rootfs --ondisk sda --fstype=ext4 --label rootfsa --part-name=mender-rootfsa --align 1024 --fixed-size 1024M --use-uuid --exclude-path boot/
part --source rootfs --ondisk sda --fstype=ext4 --label rootfsb --part-name=mender-rootfsb --align 1024 --fixed-size 1024M --use-uuid --exclude-path boot/
part /data --source rootfs --change-directory=data --ondisk sda --fstype=ext4 --label data --part-name=mender-data --align 1024 --fixed-size 64M --use-uuid --no-fstab-update
